{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "netlify",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.local; set +a; npx -y netlify-cli@27.16.2 dev --offline --port 8888 --target-port 5173 --command 'npm run dev'"
      ],
      "port": 8888
    },
    {
      "name": "vite-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_SUPABASE_URL= VITE_SUPABASE_PUBLISHABLE_KEY= npx vite --host 127.0.0.1 --port 5181 --strictPort"
      ],
      "port": 5181
    }
  ]
}
