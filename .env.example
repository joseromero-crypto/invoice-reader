VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Lean reader uses claude-sonnet-5-5 (~US$0.044 per invoice measured). See CLAUDE.md.
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_UPLOAD_BYTES=10000000
MAX_PAGES_PER_DOCUMENT=8
# Legacy settings used only by the old reader (to be removed in CLAUDE.md phase 4).
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Local dev only; never set for production. Defaults to ./private.
PRIVATE_FIXTURE_ROOT=

# Optional deployed URL for the read-only integration check (no trailing path).
SITE_URL=
